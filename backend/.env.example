# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# ── Database (MongoDB Atlas) ─────────────────────────────────────────────────
# Leave MONGODB_URI empty (or set USE_IN_MEMORY_DB=true) to run against a
# throwaway in-memory MongoDB instance — the whole app still works, seeded
# with demo data automatically, but nothing persists across restarts.
MONGODB_URI=
USE_IN_MEMORY_DB=true

# ── Auth (Firebase Authentication) ──────────────────────────────────────────
# Leave these empty to run in demo-auth mode: the API exposes its own
# email/password register+login endpoints and issues its own JWTs instead of
# verifying Firebase ID tokens. Fill these in to switch to real Firebase auth
# (email/password, Google, phone) verified server-side via firebase-admin.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Storage (Firebase Storage) ───────────────────────────────────────────────
# Leave empty to store uploaded images as inline base64 data URLs (demo mode).
FIREBASE_STORAGE_BUCKET=

# ── Maps / Geocoding ─────────────────────────────────────────────────────────
MAPS_PROVIDER=mapbox
MAPBOX_TOKEN=
GOOGLE_MAPS_API_KEY=

# ── Payments (Razorpay) ──────────────────────────────────────────────────────
# Leave empty to run payments in demo mode: orders are created locally and
# "payments" are simulated with a deterministic signature so the full
# accept -> pay -> pickup -> deliver flow can still be demonstrated. No real
# money moves in demo mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Platform settings (defaults; overridable by admin at runtime) ───────────
DEFAULT_PLATFORM_FEE_PERCENT=10

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
